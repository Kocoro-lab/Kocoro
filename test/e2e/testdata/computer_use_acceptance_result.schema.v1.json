{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kocoro.local/schemas/computer-use-acceptance-result.v1.json",
  "title": "Computer Use acceptance result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "started_at",
    "finished_at",
    "outcome",
    "classification",
    "build",
    "metrics",
    "trace_expectation_met",
    "visual_verification",
    "failures"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {
      "enum": ["passed", "failed", "partial", "blocked", "not_run"]
    },
    "classification": {
      "enum": [
        "capability_pass",
        "public_capability_regression",
        "unsupported_provider_action",
        "invalid_precondition_or_stale_state",
        "expected_safety_block",
        "inconclusive"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daemon_commit", "daemon_dirty", "desktop_app_path", "team_id"],
      "properties": {
        "daemon_commit": {"type": "string", "minLength": 7},
        "daemon_dirty": {"type": "boolean"},
        "desktop_app_path": {"type": "string", "minLength": 1},
        "team_id": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "model_calls",
        "model_timeouts",
        "initial_observation_attempts",
        "final_observation_attempts",
        "provider_batches",
        "actions",
        "action_types",
        "attempted_mutating_actions",
        "committed_mutating_actions",
        "unknown_commit_actions",
        "not_committed_mutating_actions",
        "task_count",
        "task_ordinal",
        "failed_batches",
        "confirmations"
      ],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "model_timeouts": {"type": "integer", "minimum": 0},
        "initial_observation_attempts": {"type": "integer", "minimum": 0},
        "final_observation_attempts": {"type": "integer", "minimum": 0},
        "provider_batches": {"type": "integer", "minimum": 0},
        "actions": {"type": "integer", "minimum": 0},
        "action_types": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "attempted_mutating_actions": {"type": "integer", "minimum": 0},
        "committed_mutating_actions": {"type": "integer", "minimum": 0},
        "unknown_commit_actions": {"type": "integer", "minimum": 0},
        "not_committed_mutating_actions": {"type": "integer", "minimum": 0},
        "task_count": {"type": "integer", "minimum": 1},
        "task_ordinal": {"type": "integer", "minimum": 1},
        "failed_batches": {"type": "integer", "minimum": 0},
        "confirmations": {"type": "integer", "minimum": 0}
      }
    },
    "trace_expectation_met": {"type": "boolean"},
    "visual_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "expected_states_met", "notes"],
      "properties": {
        "checked": {"type": "boolean"},
        "expected_states_met": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "code"],
        "properties": {
          "phase": {"type": "string", "minLength": 1},
          "code": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "passed"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"trace_expectation_met": {"const": true}}
      }
    }
  ]
}
